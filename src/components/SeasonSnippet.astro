---
import Anchor from "./common/Anchor.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  episodeCount: number;
  status?: string;
};

const { title, description, url, episodeCount, status } = Astro.props;
---

<div class="relative zag-text zag-transition flex flex-col gap-3 mb-8 hover-zag-dotted-grid">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
    <Anchor url={url} class="text-xl">
      {title}
    </Anchor>
    <p class="zag-muted text-sm">
      {episodeCount} {episodeCount === 1 ? "episode" : "episodes"}{status ? ` · ${status}` : ""}
    </p>
  </div>
  <p>{description}</p>
</div>
