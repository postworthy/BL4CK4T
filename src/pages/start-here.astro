---
import Layout from "../layouts/Layout.astro";
import Anchor from "../components/common/Anchor.astro";
import Section from "../components/common/Section.astro";
import { getConfigurationCollection } from "../lib/utils";

const { data: config } = await getConfigurationCollection();

const paths = [
  {
    title: "Read the story",
    text: "Enter through Season 1, where the Script Kitties discover why a city should never mistake a song for an order.",
    url: "/seasons/season-01-the-singing-network",
    cta: "Start Season 1",
  },
  {
    title: "Bring it to learners",
    text: "Use BL4CK4T as safe, story-driven cybersecurity, digital wisdom, and systems-thinking material.",
    url: "/classroom",
    cta: "Explore Classroom",
  },
  {
    title: "Build security culture",
    text: "Preview story-driven modules for reporting culture, patch ownership, and availability leadership.",
    url: "/university",
    cta: "Preview University",
  },
  {
    title: "Get the Field Guide",
    text: "Collect the seven habits that turn Cybertropolis stories into practical cyber wisdom.",
    url: "/field-guide",
    cta: "Get the Guide",
  },
];
---

<Layout>
  <Fragment slot="head">
    <title>{`Start Here • ${config.personal.name}`}</title>
    <meta name="description" content="Choose your doorway into BL4CK4T: story, classroom resources, the Field Guide, or BL4CK4T University." />
    <meta property="og:title" content={`Start Here • ${config.personal.name}`} />
    <meta property="og:description" content="Choose your doorway into Cybertropolis." />
    <meta property="og:url" content={`${config.site.baseUrl}/start-here`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={`${config.site.baseUrl}/start-here`} />
  </Fragment>
  <Section class="pt-12">
    <div class="grid gap-8 sm:grid-cols-[1fr_12rem] sm:items-center">
      <div class="flex flex-col gap-5">
        <p class="zag-muted font-mono">Enter Cybertropolis</p>
        <h1 class="font-display text-3xl sm:text-4xl leading-normal">
          BL4CK4T is a story-world for cyber wisdom.
        </h1>
        <p class="text-lg">
          Follow the Script Kitties through seasonal mysteries that teach evidence discipline, safe curiosity, reporting without shame, repair with consent, and responsible response when systems fail.
        </p>
      </div>
      <img src="/BL4CK4T.png" alt="BL4CK4T hooded cat mark" class="w-40 h-40 sm:w-48 sm:h-48 object-contain mx-auto" />
    </div>
  </Section>
  <Section>
    <div class="grid gap-4 sm:grid-cols-2">
      {paths.map((path) => (
        <article class="zag-border-b border-t-2 border-current p-4 flex flex-col gap-4">
          <h2 class="font-display text-lg leading-relaxed">{path.title}</h2>
          <p class="zag-muted">{path.text}</p>
          <Anchor url={path.url}>{path.cta}</Anchor>
        </article>
      ))}
    </div>
  </Section>
  <Section>
    <div class="zag-border-b border-t-2 border-current p-4">
      <p class="zag-muted mb-2">Core promise</p>
      <p class="text-xl">
        BL4CK4T teaches people how to protect systems without losing sight of people.
      </p>
    </div>
  </Section>
</Layout>
