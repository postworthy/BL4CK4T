---
import { getConfigurationCollection, processArticleDate } from "../lib/utils";
import type { ArticleFrontmatter } from "../lib/types";
import Anchor from "../components/common/Anchor.astro";
import Section from "../components/common/Section.astro";
import Prose from "../components/Prose.astro";
import Layout from "./Layout.astro";

type EpisodeLink = {
  title: string;
  url: string;
};

type SeasonNav = {
  title: string;
  url: string;
  label: string;
  episodeLabel: string;
  previous?: EpisodeLink;
  next?: EpisodeLink;
};

type Props = {
  frontmatter: ArticleFrontmatter;
  seasonNav?: SeasonNav;
};

const { frontmatter, seasonNav } = Astro.props;
const articleDate = processArticleDate(frontmatter.timestamp);
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <title>{`${frontmatter.title} • ${config.personal.name}`}</title>
    <meta
      name="description"
      content={frontmatter.longDescription ?? frontmatter.description}
    />
    <meta
      property="og:title"
      content={`${frontmatter.title} • ${config.personal.name}`}
    />
    <meta property="og:description" content={frontmatter.description} />
    {
      frontmatter.tags && (
        <meta name="keywords" content={frontmatter.tags.join(", ")} />
      )
    }
    {
      frontmatter.cardImage && (
        <meta property="og:image" content={frontmatter.cardImage} />
      )
    }
    <meta
      property="og:url"
      content={`${config.site.baseUrl}/blog/${frontmatter.slug}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={`${frontmatter.title} • ${config.personal.name}`}
    />
    <meta name="twitter:description" content={frontmatter.description} />
    {
      frontmatter.cardImage && (
        <meta name="twitter:image" content={frontmatter.cardImage} />
      )
    }
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <link
      rel="canonical"
      href={`${config.site.baseUrl}/blog/${frontmatter.slug}`}
    />
  </Fragment>
  <Section class="pt-8">
    <div class="flex flex-col gap-4 mt-8 mb-16">
      {
        seasonNav && (
          <div class="zag-muted flex flex-col gap-2 font-mono text-sm">
            <Anchor url={seasonNav.url} class="text-base">
              {seasonNav.title}
            </Anchor>
            <span>{seasonNav.episodeLabel}</span>
          </div>
        )
      }
      <h1
        class="text-3xl sm:text-4xl leading-normal sm:leading-normal font-display"
      >
        {frontmatter.title}
      </h1>
      <div class="flex justify-between">
        <span>{articleDate}</span>
        <span>{frontmatter.readTime} min</span>
      </div>
    </div>
    <Prose>
      <slot />
    </Prose>
    <aside class="zag-border-b border-t-2 border-current mt-12 p-4">
      <p class="zag-muted font-mono mb-2">Keep the signal</p>
      <h2 class="font-display text-lg leading-relaxed mb-4">
        Take the BL4CK4T habits with you.
      </h2>
      <p class="zag-muted mb-4">
        The free Field Guide turns the Script Kitties' cases into seven cyber habits for families, classrooms, clubs, and teams.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <Anchor url="/field-guide">Get the Field Guide</Anchor>
        <Anchor url="/newsletter">Join Field Notes</Anchor>
      </div>
    </aside>
    {
      seasonNav && (seasonNav.previous || seasonNav.next) && (
        <nav class="zag-border-b border-t-2 border-current mt-12 py-6 grid gap-6 sm:grid-cols-2">
          <div>
            {seasonNav.previous ? (
              <>
                <p class="zag-muted text-sm mb-2">Previous</p>
                <Anchor url={seasonNav.previous.url}>{seasonNav.previous.title}</Anchor>
              </>
            ) : null}
          </div>
          <div class="sm:text-right">
            {seasonNav.next ? (
              <>
                <p class="zag-muted text-sm mb-2">Next</p>
                <Anchor url={seasonNav.next.url} class="sm:justify-end">
                  {seasonNav.next.title}
                </Anchor>
              </>
            ) : null}
          </div>
        </nav>
      )
    }
    <p class="pt-8">~{config.personal.name}</p>
  </Section>
</Layout>
